# Shared 4-verifier + 4-trainer configuration for GLM-5.2 online MTP3.
#
# Copy this file to /kos_ulan, replace every FILL_* value, and use the same
# resulting file on all eight nodes. Bash syntax is required because the node
# lists are arrays. Secrets do not belong in this file.

IMAGE=${IMAGE:-quay.io/ascend/vllm-ascend:v0.23.0rc1-a3}
SHARED_ROOT=${SHARED_ROOT:-/kos_ulan}

# Four verifier nodes followed by four trainer nodes. Addresses must be the
# routable management/HCCL addresses visible in `hostname -I` on each node.
CLUSTER_VERIFIER_IPS=(
    FILL_VERIFIER_0_IP
    FILL_VERIFIER_1_IP
    FILL_VERIFIER_2_IP
    FILL_VERIFIER_3_IP
)
CLUSTER_TRAINER_IPS=(
    FILL_TRAINER_0_IP
    FILL_TRAINER_1_IP
    FILL_TRAINER_2_IP
    FILL_TRAINER_3_IP
)

# Network interface carrying the addresses above, for example eth0 or bond0.
NIC_NAME=${NIC_NAME:-FILL_HCCL_NIC_NAME}

# Prepared, non-destructive Ascend ModelSlim runtime view. Its weight symlinks
# point to VERIFIER_SOURCE_MODEL_PATH, so both paths must be visible in Docker.
VERIFIER_MODEL_PATH=${VERIFIER_MODEL_PATH:-/mnt/xds/sfs/l00936201/glm52-w4a8-mg13/v1-ascend-modelslim-v4}
VERIFIER_SOURCE_MODEL_PATH=${VERIFIER_SOURCE_MODEL_PATH:-/mnt/xds/sfs/GLM-5.2-W4A8-MG13/v1}
# The BF16 checkpoint is mandatory for MTP initialization and should live on
# shared storage; never point MTP_INIT_MODEL_PATH at the W4A8 verifier.
MTP_INIT_MODEL_PATH=${MTP_INIT_MODEL_PATH:-/kos_ulan/FILL_BF16_GLM52_PATH}
DATA_PATH=${DATA_PATH:-/kos_ulan/FILL_HF_DATASET_PATH}

HIDDEN_STATES_PATH=${HIDDEN_STATES_PATH:-/kos_ulan/spec_train/online_hidden_states/glm52-w4a8c8}
MTP_DRAFT_PATH=${MTP_DRAFT_PATH:-/kos_ulan/spec_train/initial/glm52-bf16-mtp3}
OUTPUT_PATH=${OUTPUT_PATH:-/kos_ulan/spec_train/checkpoints/glm52-w4a8c8-mtp3}
LOG_ROOT=${LOG_ROOT:-/kos_ulan/spec_train/logs/glm52-w4a8c8-mtp3}
VERIFIER_METADATA_PATH=${VERIFIER_METADATA_PATH:-/kos_ulan/spec_train/metadata/glm52-w4a8c8}
VERIFIER_RUNTIME_ROOT=${VERIFIER_RUNTIME_ROOT:-/kos_ulan/spec_train/runtime_models/glm52-w4a8c8}

# The source config label is misleading: the auxiliary tensors and
# quant_model_description.json are Ascend ModelSlim format.
VERIFIER_QUANTIZATION_MODE=${VERIFIER_QUANTIZATION_MODE:-ascend}

# Safety default: trainers run a two-step smoke test. Override with
# TRAINER_MODE=trainer only after the smoke test succeeds on all four trainers.
TRAINER_MODE=${TRAINER_MODE:-smoke}
SMOKE_RUN_ID=${SMOKE_RUN_ID:-FILL_UNIQUE_SMOKE_ID}

# Production is intentionally two-phase:
#   epoch 1: online-cache (generate missing states and persist them)
#   epoch 2+: offline (strictly reuse cache; verifier can be stopped)
TRAINER_DATA_MODE=${TRAINER_DATA_MODE:-online-cache}

# Verifier: each node runs DP2 x TP8 over its 16 NPUs.
VERIFIER_PORT=${VERIFIER_PORT:-8077}
VERIFIER_DP_SIZE=${VERIFIER_DP_SIZE:-2}
VERIFIER_TP_SIZE=${VERIFIER_TP_SIZE:-8}
VERIFIER_MAX_MODEL_LEN=${VERIFIER_MAX_MODEL_LEN:-32769}
VERIFIER_MAX_NUM_SEQS=${VERIFIER_MAX_NUM_SEQS:-8}
VERIFIER_MAX_BATCHED_TOKENS=${VERIFIER_MAX_BATCHED_TOKENS:-32768}
VERIFIER_GPU_MEMORY_UTILIZATION=${VERIFIER_GPU_MEMORY_UTILIZATION:-0.92}

# Training defaults. Four trainers x 16 NPUs = 64 distributed ranks.
NPROC_PER_NODE=${NPROC_PER_NODE:-16}
MASTER_PORT=${MASTER_PORT:-29500}
TOTAL_SEQ_LEN=${TOTAL_SEQ_LEN:-32768}
EPOCHS=${EPOCHS:-5}
LR=${LR:-1e-4}
WEIGHT_DECAY=${WEIGHT_DECAY:-0.01}
CHECKPOINT_STEPS=${CHECKPOINT_STEPS:-1000}
NUM_WORKERS=${NUM_WORKERS:-1}
PREFETCH_FACTOR=${PREFETCH_FACTOR:-2}
# A full 32K prefill plus hidden-state serialization can exceed the generic
# 120-second client default, especially when requests queue behind DP2.
REQUEST_TIMEOUT=${REQUEST_TIMEOUT:-900}
MAX_RETRIES=${MAX_RETRIES:-3}

# If automatic IP discovery is ambiguous on a node, set NODE_IP in that
# node's shell (do not edit the shared file): NODE_IP=10.0.0.12 bash ...
